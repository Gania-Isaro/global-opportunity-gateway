# Copy this file to .env and adjust the values.

# PostgreSQL connection string.
# Local Docker database (see docker-compose.yml):
DATABASE_URL=postgres://gog:gog@localhost:5432/gog
# Set to true for hosted databases that require SSL (for example Neon).
DATABASE_SSL=false

# Long random string used to sign session cookies. Change it in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Public address of the app. Used inside email links.
# Local development uses the Vite dev server on port 5173.
APP_URL=http://localhost:5173

# Port for the API server.
PORT=4000

# When true, confirmation and password reset links are also shown on screen,
# so the prototype can be tested without a real mailbox.
DEMO_MODE=true

# When true, the server adds the demo accounts and challenges on first start
# if the database is empty.
SEED_DEMO_DATA=true

# Optional SMTP settings for real emails. Leave empty to print emails to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=GOG <no-reply@gog.rw>
