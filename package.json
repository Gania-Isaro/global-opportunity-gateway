{
  "name": "global-opportunity-gateway",
  "version": "1.0.0",
  "description": "GOG (Global Opportunity Gateway): a platform that turns real challenges in Kigali into teams and teams into working projects.",
  "author": "Gania Isaro Kayumba",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "npm run dev --prefix client",
    "build": "npm install --prefix client --include=dev && npm run build --prefix client",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "express-session": "^1.18.1",
    "multer": "^2.0.2",
    "nodemailer": "^10.3.1",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
